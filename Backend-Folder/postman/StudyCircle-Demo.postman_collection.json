{
  "info": {
    "name": "StudyCircle Demo (fresh)",
    "description": "Self-contained demo collection with its own test account. Run '1. Sign In' first, then everything else works immediately — groupId/inviteCode are already filled in from a real circle created moments ago.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{idToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "default"
    },
    {
      "key": "firebaseApiKey",
      "value": "AIzaSyDBnR_KcsFJxx3KqsmRVIKvlqZqrHqrvqs",
      "type": "default"
    },
    {
      "key": "testEmail",
      "value": "demo.reviewer@studycircle.dev",
      "type": "default"
    },
    {
      "key": "testPassword",
      "value": "DemoReview2026!",
      "type": "default"
    },
    {
      "key": "idToken",
      "value": "eyJhbGciOiJSUzI1NiIsImtpZCI6IjIwY2FkODZkNzY5ZmFkZTViODkxNmQ5Y2U1MDc0YzgyMGYwNjdkNTIiLCJ0eXAiOiJKV1QifQ..loyAaroZOjlXP2s8PtPFgEErKwa5Z9_TMjn0XLBghS0UWS55BH4IfbZuK3cRHxz5_SWqnzJUDvkZ8zCJvsj1_1-GxPNfrzzP7gOlxs5pjAYJw16buj3_g59fH8Ja3hDgfAB24bnf-Xz5A-0PkkibCikRMZJtFyTm2LBMRk9mHlgTzDkNPWjtzgRzoMimQSr82_6BwKg_9CtdAzLPvjz7JJ-r4vhtBA59CGkiDrn_LifFfyEPrf_yufhHi4LGjBfsV7ViaQGQlXxANgAtGc_q5e_M7cBRru-VTCeXd2a_5eFm2r_sUbg-So4X1K2gzRKtMcCEe8w9oA27X-0Hvvqu0w",
      "type": "default"
    },
    {
      "key": "groupId",
      "value": "e201a743-cccc-4c2d-8d25-7acb2cfd35f2",
      "type": "default"
    },
    {
      "key": "inviteCode",
      "value": "4i8ox0r",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "1. Sign In (re-run if token expires after 1hr)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.idToken) { pm.collectionVariables.set('idToken', data.idToken); console.log('idToken saved'); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"returnSecureToken\": true\n}"
        }
      },
      "response": []
    },
    {
      "name": "Get my profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me"
      },
      "response": []
    },
    {
      "name": "Get my dashboard",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me/dashboard"
      },
      "response": []
    },
    {
      "name": "Get my tasks (assignments)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me/tasks"
      },
      "response": []
    },
    {
      "name": "Get my notifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users/me/notifications"
      },
      "response": []
    },
    {
      "name": "Create a circle",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/groups",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Demo Circle\",\n  \"courseName\": \"Live Test\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data?.data?.group) { pm.collectionVariables.set('groupId', data.data.group.id); pm.collectionVariables.set('inviteCode', data.data.group.inviteCode); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Preview circle by invite code (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/groups/invite/{{inviteCode}}",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "Invite a member by email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/groups/{{groupId}}/invitations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emails\": [\n    \"your.real.email@example.com\"\n  ]\n}"
        }
      },
      "response": []
    },
    {
      "name": "Join circle via invite code",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/groups/{{inviteCode}}/join"
      },
      "response": []
    },
    {
      "name": "Get one circle",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/groups/{{groupId}}"
      },
      "response": []
    },
    {
      "name": "Create a task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/groups/{{groupId}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Read Chapter 4\",\n  \"dueDate\": \"2026-08-15T23:59:00.000Z\"\n}"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data?.data?.id) pm.collectionVariables.set('taskId', data.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update task status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/groups/{{groupId}}/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DOING\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Daily check-in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/groups/{{groupId}}/checkins",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DONE\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Schedule a session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/groups/{{groupId}}/sessions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Live Demo Study Session\",\n  \"startTime\": \"2026-08-01T10:00:00.000Z\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "List sessions for a circle",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/groups/{{groupId}}/sessions"
      },
      "response": []
    }
  ]
}