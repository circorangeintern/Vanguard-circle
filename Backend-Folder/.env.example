# Postgres connection string — this is a shared Neon DB, ask a teammate for
# the real value rather than pointing this at a local Postgres instance.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Firebase Admin SDK — from Firebase Console -> Project Settings -> Service
# Accounts -> Generate new private key. Ask a teammate for the real values;
# they're tied to the shared study-circle-app-285a7 Firebase project.
FIREBASE_PROJECT_ID=study-circle-app-285a7
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@study-circle-app-285a7.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

PORT=4000

# Resend API key for sending invite emails — ask a teammate.
RESEND_API_KEY=

# The frontend origin allowed through CORS. http://localhost:5173 is already
# allowed by default in server.js; only set this if you need something else.
FRONTEND_URL=http://localhost:5173

# Google OAuth credentials for the Calendar sync feature — from Google Cloud
# Console -> APIs & Services -> Clients. Ask a teammate for the real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/calendar/callback
