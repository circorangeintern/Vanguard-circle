// StudyCircle — Core Data Model
// Reflects agreed implementation clarifications:
// - Streaks & CheckIns are scoped per (User, Group), not per User overall
// - Tasks are assignable to a specific member (ownership)
// - Notifications support bundling across groups

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZER
  MEMBER
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum CheckInStatus {
  DONE
  IN_PROGRESS
  SKIPPED
}

enum NotificationChannel {
  WEB_PUSH
  WHATSAPP
  EMAIL
}

// A circle's preferred delivery channel for study reminders — separate from
// NotificationChannel (which is per-notification, used by the existing
// in-app notification system). Only IN_APP and EMAIL are actually delivered
// today; WHATSAPP/SMS are selectable and tracked but not yet wired to a
// real provider (would need Twilio or similar).
enum ReminderChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PostType {
  ANNOUNCEMENT
  RESOURCE
}

enum CalendarSourceType {
  SESSION
  TASK
}

model User {
  id         String   @id @default(uuid())
  firebaseUid String  @unique
  name       String
  email      String   @unique
  phone      String?
  createdAt  DateTime @default(now())

  memberships   Membership[]
  tasksOwned    Task[]        @relation("TaskOwner")
  checkIns      CheckIn[]
  streaks       Streak[]
  notifications Notification[]
  postsAuthored Post[]        @relation("PostAuthor")
  postLikes     PostLike[]
  postComments  PostComment[]
  calendarConnection CalendarConnection?
  calendarSyncedEvents CalendarSyncedEvent[]
}

model Group {
  id                 String   @id @default(uuid())
  name               String
  courseName         String
  description        String?
  icon               String?
  visibility         String   @default("private")
  approval           Boolean  @default(false)
  maxMembers         Int?
  allowMemberInvites Boolean  @default(true)
  requireAdminApproval Boolean @default(true)
  studyReminders      Boolean @default(true)
  reminderFrequency   String   @default("Every day")
  reminderTime        String   @default("09:00 AM")
  reminderChannel     ReminderChannel @default(IN_APP)
  inviteCode          String   @unique
  createdBy           String
  createdAt           DateTime @default(now())

  memberships   Membership[]
  tasks         Task[]
  checkIns      CheckIn[]
  streaks       Streak[]
  invitations   Invitation[]
  studySessions StudySession[]
  posts         Post[]
}

// Join table — a User can belong to many Groups (supports the cross-circle dashboard)
model Membership {
  id       String   @id @default(uuid())
  userId   String
  groupId  String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Invitation {
  id         String           @id @default(uuid())
  groupId    String
  invitedBy  String
  email      String
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  group Group @relation(fields: [groupId], references: [id])
}

model Task {
  id             String     @id @default(uuid())
  groupId        String
  title          String
  dueDate        DateTime
  status         TaskStatus @default(TODO)
  assignedTo     String?    // ownership field — nullable until assigned
  reminderDaysBefore Int?   // user-configured "remind me N days before due"; null = default 24h window
  reminderSentAt DateTime?  // set once a "due soon" notification has fired, so it never repeats
  createdAt      DateTime   @default(now())

  group Group @relation(fields: [groupId], references: [id])
  owner User? @relation("TaskOwner", fields: [assignedTo], references: [id])
}

// Scoped per (User, Group) — a user checks in separately for each circle
model CheckIn {
  id        String        @id @default(uuid())
  userId    String
  groupId   String
  date      DateTime      @default(now())
  status    CheckInStatus
  createdAt DateTime      @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId, date])
}

// Scoped per (User, Group) — matches the "streaks per circle, not per user" clarification
model Streak {
  id               String   @id @default(uuid())
  userId           String
  groupId          String
  currentStreak    Int      @default(0)
  lastCheckInDate  DateTime?
  updatedAt        DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel
  payload   Json
  bundled   Boolean             @default(false) // true if this combines multiple groups' reminders
  read      Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])
}

// A circle's activity feed post — announcement or shared resource.
// Attachment is link-only for now (a pasted URL + label), no file storage.
model Post {
  id             String   @id @default(uuid())
  groupId        String
  authorId       String
  type           PostType @default(ANNOUNCEMENT)
  title          String
  content        String
  attachmentName String?
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  group    Group         @relation(fields: [groupId], references: [id])
  author   User          @relation("PostAuthor", fields: [authorId], references: [id])
  likes    PostLike[]
  comments PostComment[]
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

// One Google account connected per user — a one-way (StudyCircle -> Google)
// push sync, not a full two-way calendar integration.
model CalendarConnection {
  id               String    @id @default(uuid())
  userId           String    @unique
  googleEmail      String
  accessToken      String
  refreshToken     String
  tokenExpiresAt   DateTime
  syncSessions     Boolean   @default(true)
  syncAssignments  Boolean   @default(true)
  syncReminders    Boolean   @default(false)
  lastSyncedAt     DateTime?
  connectedAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Maps a StudyCircle session/task to the Google Calendar event it was
// pushed to, so re-syncing updates the existing event instead of duplicating it.
model CalendarSyncedEvent {
  id            String             @id @default(uuid())
  userId        String
  sourceType    CalendarSourceType
  sourceId      String
  googleEventId String
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, sourceType, sourceId])
}

// A scheduled study session or group check-in for a circle — powers the
// dashboard's "Today's Agenda" (previously static placeholder data).
model StudySession {
  id              String    @id @default(uuid())
  groupId         String
  title           String
  description     String?
  startTime       DateTime
  durationMinutes Int       @default(60)
  meetingLink     String?
  createdBy       String
  reminderSentAt  DateTime? // set once a "starting soon" notification has fired
  createdAt       DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id])
}
